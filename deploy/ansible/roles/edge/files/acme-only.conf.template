# The edge before it has a certificate: port 80 answers Let's Encrypt's HTTP-01 challenge from
# certbot's webroot and nothing else. roles/edge serves this site only while it gets the first
# certificate, then switches to infra/nginx/templates/https.
server {
    listen 8080 default_server;
    server_name _;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location / {
        return 503;
    }
}
