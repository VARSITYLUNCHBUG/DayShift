# Local dev stack against the Discord simulator. `make dev` copies this to .env.dev when it's
# missing. Nothing here is secret: the token is fake and only the simulator accepts it.
# compose.dev.yaml also sets DEBUG, DEV_CONTROL and the database for every service.

# Django
DJANGO_SECRET_KEY=dev-only-not-secret
SECURE_COOKIES=false
LOG_LEVEL=INFO

# Discord, pointed at the simulator (the discord-sim service). Its seeded guild has this id.
DISCORD_TOKEN=sim-token
DISCORD_GUILD_ID=1100000000000000001
DISCORD_API_BASE=http://discord-sim:8090/api/v10
DISCORD_GATEWAY_URL=ws://discord-sim:8090/gateway
DISCORD_SIM_URL=http://discord-sim:8090

# The player web UI, through the edge (docs/web-ui.md). Change PUBLIC_URL with DEV_EDGE_PORT.
PUBLIC_URL=http://localhost:18080
# Its server: empty means DISCORD_GUILD_ID, the simulator's guild.
WEB_GUILD_ID=
# The simulator has no OAuth2, so these stay empty and the dev login is how to sign in.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_INVITE_URL=
KOFI_URL=
# Threads the web process runs database work on.
# WEB_DB_THREADS=8
# Sign in as any player, or a new stand-in, at /auth/dev/ (needs DEBUG, which the dev stack sets).
WEB_DEV_LOGIN=true

# Everything below is a compose variable, read from the shell (or `make dev VAR=value`), not
# from this file. Host ports, all on 127.0.0.1:
#   DEV_EDGE_PORT=18080  DEV_WEB_PORT=18000  DEV_SIM_PORT=18090  DEV_PANEL_PORT=18091
#   DEV_DB_PORT=15432
# The log format (text, or json) and fake members the simulator seeds:
#   LOG_FORMAT=text  SIM_SEED_USERS=0
