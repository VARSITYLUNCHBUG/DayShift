# The app image's build context is an allowlist: only what the services run. Everything else
# (tests, docs, deploy, services/, scripts, local env files, caches) stays out.
*
!bot/
!config/
!devtools/
!fixtures/
!league/
!presets/
!scoreocr/
!manage.py
!pyproject.toml
!uv.lock
# The player web UI's sources, for an image stage that builds them (the HeroUI branch), without
# what a local build left behind.
!frontend/
frontend/node_modules
frontend/dist

# Local bytecode caches inside those; the image compiles its own.
**/__pycache__
**/*.py[co]
