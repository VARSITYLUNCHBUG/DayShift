# The observability overlay's secrets (compose.observability.yaml). Copy to .env.observability
# and fill in. Never commit it. Only Grafana and Alertmanager read this file: the app's containers
# (which get all of .env) never see these.
#
# DB_MONITOR_PASSWORD, the exporters' database password, goes in .env instead: compose needs it
# to configure migrate, pgbouncer and the exporters, and blanks it for the app.

# Required: Grafana's `admin` user. Grafana only reads it when it first creates its database.
GRAFANA_ADMIN_PASSWORD=

# Optional: a Discord channel's webhook URL. Without it, alerts only show in Grafana and
# Prometheus.
ALERTMANAGER_DISCORD_WEBHOOK_URL=

# Optional: a dead man's switch URL (a healthchecks.io check, say). Alertmanager pings it every
# minute with the always-firing Watchdog alert, so something outside this host notices when
# alerting itself goes down. See docs/ops/alerts.md#watchdog.
ALERTMANAGER_WATCHDOG_URL=
