# {{ ansible_managed }}
# Written by Ansible from the inventory and the vault. Edit those and run site.yml, not this file.
# migrate, web, bot and scheduler get all of it. The observability services' own secrets are in
# .env.observability (roles/observability), which the app never sees.
COMPOSE_FILE='{{ app_compose_file_names | join(":") }}'
{% if app_image %}
DRAFTBOT_IMAGE='{{ app_image }}'
{% endif %}
DRAFTBOT_IMAGE_TAG='{{ app_image_tag }}'
# The edge's TLS site and certificate, and the certificate probe.
EDGE_SERVER_NAME='{{ app_domain }}'
# The edge's admin access rules (roles/edge): empty unless the inventory sets some.
EDGE_ADMIN_ACCESS_DIR='./edge/admin-access'

# Discord
DISCORD_TOKEN='{{ app_discord_token }}'
DISCORD_GUILD_ID='{{ app_discord_guild_id }}'
ERROR_LOG_CHANNEL_ID='{{ app_error_log_channel_id }}'

# Django, behind the edge's TLS. compose.prod.yaml forces DEBUG off as well.
DJANGO_SECRET_KEY='{{ app_django_secret_key }}'
DEBUG='false'
ALLOWED_HOSTS='{{ app_domain }}'
CSRF_TRUSTED_ORIGINS='https://{{ app_domain }}'
BEHIND_TLS_PROXY='true'
SECURE_COOKIES='true'
LOG_LEVEL='{{ app_log_level }}'

# Database. compose.yaml builds the containers' URLs from these: web, bot and scheduler log in
# as draftbot_app through pgbouncer; migrate as the superuser, straight to Postgres. compose
# blanks POSTGRES_PASSWORD for all but migrate and db.
POSTGRES_PASSWORD='{{ app_postgres_password }}'
DB_APP_PASSWORD='{{ app_db_app_password }}'

# Player web UI
PUBLIC_URL='https://{{ app_domain }}'
DISCORD_CLIENT_ID='{{ app_discord_client_id }}'
DISCORD_CLIENT_SECRET='{{ app_discord_client_secret }}'

# Optional services
DEADLOCK_API_KEY='{{ app_deadlock_api_key }}'
STEAM_WEB_API_KEY='{{ app_steam_web_api_key }}'
{% if app_observability | bool %}

# Observability (compose.observability.yaml). The exporters' database role: compose hands it to
# migrate, pgbouncer and the exporters, and blanks it for web, bot and scheduler.
DB_MONITOR_PASSWORD='{{ app_db_monitor_password }}'
{% if app_grafana_domain %}
GRAFANA_DOMAIN='{{ app_grafana_domain }}'
{% endif %}
{% endif %}
{% if app_env_extra %}

# app_env_extra
{% for key, value in app_env_extra | dictsort %}
{{ key }}='{{ value }}'
{% endfor %}
{% endif %}
