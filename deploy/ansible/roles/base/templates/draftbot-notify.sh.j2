#!/usr/bin/env bash
# {{ ansible_managed }}
# Reports a failed unit: always to the journal, and to a Discord webhook when
# {{ base_notify_webhook_config }} names one. draftbot-notify@<unit>.service runs it.
set -euo pipefail

unit=$1
conf={{ base_notify_webhook_config | quote }}
# uname -n, not hostname -f: that fails on a server whose own name doesn't resolve, and this
# script must not.
summary="$unit failed on $(uname -n). journalctl -u $unit for the whole log."
logger --tag draftbot-notify --priority user.err "$summary"

if [ -s "$conf" ]; then
    # Discord caps a message at 2000 characters: the summary and the unit's last lines.
    tail=$(journalctl --unit "$unit" --lines 15 --no-pager --output cat | tail -c 1500)
    jq --null-input --arg summary "$summary" --arg tail "$tail" \
        '{content: ($summary + "\n```\n" + $tail + "\n```")}' \
        | curl --config "$conf" --fail --silent --show-error --max-time 15 \
            --header 'Content-Type: application/json' --data-binary @-
fi
