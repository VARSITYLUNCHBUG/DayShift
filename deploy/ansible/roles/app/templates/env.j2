# {{ ansible_managed }}
# Written by Ansible from the inventory and the vault. Edit those and run site.yml, not this file.
COMPOSE_FILE='compose.yaml:compose.prod.yaml'
{% if dayshift_image %}
DAYSHIFT_IMAGE='{{ dayshift_image }}'
{% endif %}
DAYSHIFT_IMAGE_TAG='{{ dayshift_image_tag }}'

# The edge: HTTPS for this name, with a certificate Caddy gets and renews itself.
EDGE_SITE='{{ dayshift_domain }}'
{% if dayshift_tls_internal | bool %}
EDGE_TLS='tls internal'
{% endif %}
{% if dayshift_admin_cidrs %}
EDGE_ADMIN_CIDRS='{{ dayshift_admin_cidrs | join(" ") }}'
{% endif %}

# Discord
DISCORD_TOKEN='{{ dayshift_discord_token }}'
DISCORD_GUILD_ID='{{ dayshift_discord_guild_id }}'
ERROR_LOG_CHANNEL_ID='{{ dayshift_error_log_channel_id }}'
HEALTHCHECK_PING_URL='{{ dayshift_healthcheck_ping_url }}'

# Django, behind the edge's TLS. compose.prod.yaml forces DEBUG off as well.
DJANGO_SECRET_KEY='{{ dayshift_django_secret_key }}'
DEBUG='false'
ALLOWED_HOSTS='{{ dayshift_domain }}'
CSRF_TRUSTED_ORIGINS='https://{{ dayshift_domain }}'
BEHIND_TLS_PROXY='true'
SECURE_COOKIES='true'
LOG_LEVEL='{{ dayshift_log_level }}'

# Postgres. compose builds the app's DATABASE_URL from it.
POSTGRES_PASSWORD='{{ dayshift_postgres_password }}'

# Optional services
DEADLOCK_API_KEY='{{ dayshift_deadlock_api_key }}'
STEAM_WEB_API_KEY='{{ dayshift_steam_web_api_key }}'
{% for key, value in dayshift_env_extra | dictsort %}
{{ key }}='{{ value }}'
{% endfor %}
