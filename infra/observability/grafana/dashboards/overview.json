{
  "uid": "draftbot-overview",
  "title": "Draft bot: overview",
  "description": "Is everything up, and is the league moving.",
  "tags": [
    "draftbot"
  ],
  "timezone": "utc",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
