#!/usr/bin/env bash
# {{ ansible_managed }}
# Posts a message to the alert webhook (vault_alert_webhook_url), and always logs it to the journal.
#   dayshift-notify "message"        dayshift-notify --unit <unit>   (a failed unit, with its log)
set -euo pipefail

if [ "${1:-}" = "--unit" ]; then
    unit=$2
    message="$unit failed on $(uname -n):"$'\n```\n'"$(journalctl --unit "$unit" --lines 15 --no-pager --output cat | tail -c 1500)"$'\n```'
else
    message=$1
fi
logger --tag dayshift-notify --priority user.warning "$message"

webhook={{ dayshift_alert_webhook_url | quote }}
if [ -n "$webhook" ]; then
    # Discord caps a message at 2000 characters.
    jq --null-input --arg content "${message:0:1900}" '{content: $content}' \
        | curl --fail --silent --show-error --max-time 15 \
            --header 'Content-Type: application/json' --data-binary @- "$webhook" > /dev/null
fi
