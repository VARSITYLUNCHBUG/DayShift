---
# Copy to vault.yml, fill in, then encrypt it: ansible-vault encrypt vault.yml
# Generate the key and the password with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
#   openssl rand -hex 32

# Required.
vault_discord_token: ""
vault_django_secret_key: ""
# Letters and digits only: it goes into a database URL.
vault_postgres_password: ""

# Optional. A Discord channel webhook told when a container turns unhealthy or a backup fails.
vault_alert_webhook_url: ""
# Optional. A dead man's switch such as a healthchecks.io check URL, pinged by the bot every minute.
vault_healthcheck_ping_url: ""
# Optional API keys.
vault_deadlock_api_key: ""
vault_steam_web_api_key: ""
# Optional: the player web UI's Discord OAuth app secret (Developer Portal, OAuth2).
vault_discord_client_secret: ""
# Only for a private image: a registry token that can read it.
vault_registry_password: ""
