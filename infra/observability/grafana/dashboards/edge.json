{
  "uid": "draftbot-edge",
  "title": "Draft bot: edge and web",
  "description": "Traffic through nginx, and the web process's requests by route.",
  "tags": [
    "draftbot"
  ],
  "timezone": "utc",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
