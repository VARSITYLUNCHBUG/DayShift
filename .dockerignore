# The app image's build context is an allowlist: only what the services run. Everything else
# (tests, docs, deploy, services/, scripts, local env files, caches) stays out.
*
!bot/
!config/
!devtools/
!fixtures/
!league/
!presets/
!scoreocr/
# The unit suite, for the `test` target only: the runtime and dev targets copy named folders.
# Two control-panel sources (tests/test_devtools_panel_contract.py checks them) and the Discord
# simulator's package (tests/test_devtools_sim_heroes.py serves its heroes).
!tests/
tests/e2e/
!services/control-panel/src/api/control.ts
!services/control-panel/src/lib/match.ts
!services/discord-sim/src/
# The player web UI's sources, for the Dockerfile's web stage, which installs and builds its own:
# never a local install, build or test output.
!services/web/
services/web/node_modules/
services/web/dist/
services/web/e2e/
services/web/test-results/
services/web/playwright-report/
services/web/blob-report/
services/web/playwright/.cache/
services/web/*.tsbuildinfo
!manage.py
!pyproject.toml
!uv.lock
# Local bytecode caches inside those; the image compiles its own.
**/__pycache__
**/*.py[co]
