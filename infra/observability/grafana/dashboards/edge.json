    {
      "type": "timeseries",
      "title": "Dropped connections",
      "description": "Accepted but not handled: worker_connections is exhausted.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(nginx_connections_accepted[$__rate_interval])) - sum(rate(nginx_connections_handled[$__rate_interval]))",
          "legendFormat": "dropped"
        }
