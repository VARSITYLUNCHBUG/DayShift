# {{ ansible_managed }}
# Access control for the Django admin, from the inventory's edge_admin_* settings. The edge
# includes this in its /admin/ locations, the login form included (infra/nginx/snippets/app.conf).
{% if edge_admin_allow_cidrs and edge_admin_basic_auth_users %}
satisfy {{ edge_admin_satisfy }};
{% endif %}
{% for cidr in edge_admin_allow_cidrs %}
allow {{ cidr }};
{% endfor %}
{% if edge_admin_allow_cidrs %}
deny all;
{% endif %}
{% if edge_admin_basic_auth_users %}
auth_basic "Admin";
auth_basic_user_file /etc/nginx/admin-access/htpasswd;
{% endif %}
