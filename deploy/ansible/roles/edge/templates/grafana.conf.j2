# {{ ansible_managed }}
# Grafana at https://{{ edge_grafana_domain }}, on the edge's certificate. compose.grafana.yaml
# mounts this into the edge's conf.d and puts the edge and Grafana on a network of their own.

upstream grafana {
    zone grafana 64k;
    server grafana:3000 resolve;
    keepalive 4;
}

server {
    listen 8443 ssl;
    # As the app's site: without it, an IPv6 client meets the default server, which refuses the
    # handshake.
    listen [::]:8443 ssl;
    http2 on;
    server_name {{ edge_grafana_domain }};

    ssl_certificate /etc/letsencrypt/live/{{ edge_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ edge_domain }}/privkey.pem;
    include /etc/nginx/snippets/tls.conf;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    include /etc/nginx/snippets/security-headers.conf;
    include /etc/nginx/snippets/proxy.conf;
{% for cidr in edge_grafana_allow_cidrs %}
    allow {{ cidr }};
{% endfor %}
{% if edge_grafana_allow_cidrs %}
    deny all;
{% endif %}

    # The general per-address limits (snippets/rate-limits.conf), which also cap guesses at the
    # password prompt. Not the admin's `prompt` zone: a dashboard sends a request per panel at
    # once, and a request a second would refuse most of them.
    limit_req zone=per_client burst=50 nodelay;
    limit_conn per_client_conn 100;

    auth_basic "Grafana";
    auth_basic_user_file /etc/nginx/grafana.htpasswd;
    # Grafana would read the prompt's credentials as a login of its own.
    proxy_set_header Authorization "";

    location / {
        proxy_pass http://grafana;
    }

    # Grafana's own login, rate limited like the app's sign-in.
    location = /login {
        limit_req zone=auth burst=20 nodelay;
        proxy_pass http://grafana;
    }

    # Grafana Live, a websocket held open for as long as a dashboard is.
    location /api/live/ {
        proxy_pass http://grafana;
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }
}
