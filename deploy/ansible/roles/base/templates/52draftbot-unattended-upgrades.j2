// {{ ansible_managed }}
{% if base_unattended_docker %}
// Docker's own repository, on top of the distribution's security updates: docker-ce,
// containerd.io (and the runc it ships) and the compose plugin. dockerd restarts on an upgrade;
// containers keep running (live-restore in /etc/docker/daemon.json).
Unattended-Upgrade::Origins-Pattern {
    "origin=Docker,label=Docker CE";
};
{% else %}
// Docker's own repository isn't an allowed origin (base_unattended_docker is off): Docker stays
// as it is until site.yml runs with -e docker_upgrade=true.
{% endif %}
Unattended-Upgrade::Remove-Unused-Dependencies "true";
Unattended-Upgrade::Automatic-Reboot "{{ base_unattended_reboot | ternary('true', 'false') }}";
Unattended-Upgrade::Automatic-Reboot-Time "{{ base_unattended_reboot_time }}";
