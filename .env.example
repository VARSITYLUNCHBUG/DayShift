# Copy to .env and fill in. Never commit .env.
#
# The app's environment: compose hands all of it to migrate, web and bot, and also reads it for
# the compose variables further down. A server deployed with Ansible gets one written from its
# inventory and vault instead (deploy/).

# Discord
DISCORD_TOKEN=
DISCORD_GUILD_ID=

# Django
DJANGO_SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://play.example.com
# Set both if the admin sits behind TLS (the edge with a domain does that). Without TLS, set
# SECURE_COOKIES=false.
# BEHIND_TLS_PROXY=true
SECURE_COOKIES=false

# Database: one login for migrate and the app. compose builds the containers' DATABASE_URL from
# POSTGRES_PASSWORD; DATABASE_URL here is only for running manage.py on this machine against the
# compose database (published on 127.0.0.1:DB_PORT). The password goes into URLs, so use letters
# and digits only (openssl rand -hex 32).
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://dayshift:change-me@127.0.0.1:55432/dayshift

# Compose variables, with their defaults. Where the edge listens on this machine
# (http://127.0.0.1:8000), where Postgres is published for host tools, and the image
# `docker compose pull` fetches (`--build` builds it here instead, INSTALL_OCR=true with score OCR).
# EDGE_PORT=8000
# DB_PORT=55432
# DAYSHIFT_IMAGE=ghcr.io/varsitylunchbug/dayshift
# DAYSHIFT_IMAGE_TAG=latest
# INSTALL_OCR=false
# The edge's site address (infra/caddy/Caddyfile): `:8080` is plain HTTP; a domain turns on
# automatic HTTPS. Who may open /admin/, as space-separated CIDRs (everyone by default).
# EDGE_SITE=:8080
# EDGE_ADMIN_CIDRS=0.0.0.0/0 ::/0
# Postgres memory, for its 1 GB container limit.
# POSTGRES_SHARED_BUFFERS=256MB
# POSTGRES_EFFECTIVE_CACHE_SIZE=768MB

LOG_LEVEL=INFO
# json (the default) or text, which reads better in a terminal.
# LOG_FORMAT=json
# Optional. A channel ID where the bot posts every error with its full traceback, and the health
# watchdog's alerts, for whoever runs the bot. Each server can also pick its own channel for its
# own errors: /seterrorchannel.
ERROR_LOG_CHANNEL_ID=
# Optional. A dead man's switch such as a healthchecks.io check URL: the bot pings it every
# minute while the league keeps up, and URL/fail when it doesn't.
HEALTHCHECK_PING_URL=

# deadlock-api.com. Optional key: raises its limits, such as bot-hosted lobbies from 10 an hour
# per IP to 100 per 30 minutes. The lobby region and result checks are settings in the admin.
DEADLOCK_API_KEY=
# Optional. Only needed for /link with a custom profile URL (steamcommunity.com/id/name).
STEAM_WEB_API_KEY=
