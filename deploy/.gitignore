# Each client's inventory holds their server and vault: keep it in your own private repository,
# not here. Only the example is tracked.
/ansible/inventories/*
!/ansible/inventories/example/
/ansible/inventories/example/group_vars/all/vault.yml

# Collections from requirements.yml, ansible-lint's cache, dumps fetched by backup.yml, and the
# vault password file.
/ansible/collections/
/ansible/.ansible/
/ansible/backups/
/ansible/.vault-pass
*.retry
