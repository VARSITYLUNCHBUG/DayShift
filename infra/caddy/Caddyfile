# The edge: the stack's only way in. Caddy proxies everything to web, which serves the static
# files itself (WhiteNoise). compose.yaml mounts this file; every setting below comes from the
# environment, so dev, test and production run it unchanged:
#
#   EDGE_SITE         the site address. `:8080` (the default) is plain HTTP, for 127.0.0.1. A
#                     domain, such as `play.example.com`, turns on automatic HTTPS: Caddy gets
#                     and renews the certificate from Let's Encrypt by itself, keeps it in the
#                     caddy-data volume, and redirects HTTP to HTTPS.
#   EDGE_ADMIN_CIDRS  who may open /admin/, space separated. Everyone by default.
#
# Inside the container Caddy listens on 8080 and 8443, so it needs no capabilities; compose maps
# the host's ports onto those.
{
	admin off
	http_port 8080
	https_port 8443
}

{$EDGE_SITE::8080} {
	encode zstd gzip

	# Report screenshots are the largest uploads.
	request_body {
		max_size 21MB
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	@admin_refused {
		path /admin /admin/*
		not remote_ip {$EDGE_ADMIN_CIDRS:0.0.0.0/0 ::/0}
	}
	respond @admin_refused 403

	reverse_proxy web:8000

	log
}

# The container's healthcheck, on loopback only.
http://127.0.0.1:8081 {
	respond "ok" 200
}
