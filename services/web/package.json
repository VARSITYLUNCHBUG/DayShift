{
  "name": "dayshift-web",
  "private": true,
  "version": "0.1.0",
  "description": "DayShift: the player web app (React, HeroUI v3), served by Django from /static/web/.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0 && stylelint \"src/**/*.css\"",
    "test": "vitest run",
    "gen": "node scripts/gen-protocol.mjs",
    "check:gen": "node scripts/gen-protocol.mjs --check",
    "check": "npm run typecheck && npm run typecheck:e2e && npm run lint && npm test",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "e2e": "bash ../../scripts/web-e2e.sh --full",
    "e2e:smoke": "bash ../../scripts/web-e2e.sh --smoke"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@gravity-ui/icons": "2.23.1",
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "@internationalized/date": "3.12.4",
    "@react-aria/ssr": "3.10.1",
    "@react-aria/utils": "3.34.1",
    "@tanstack/react-query": "5.107.1",
    "react": "19.3.1",
    "react-aria": "3.53.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "json-schema-to-typescript": "16.0.0",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
