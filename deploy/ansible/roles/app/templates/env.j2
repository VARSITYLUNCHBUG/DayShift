# {{ ansible_managed }}
# Written by Ansible from the inventory and the vault. Edit those and run site.yml, not this file.
COMPOSE_FILE='compose.yaml:compose.prod.yaml'
{% if draftbot_image %}
DRAFTBOT_IMAGE='{{ draftbot_image }}'
{% endif %}
DRAFTBOT_IMAGE_TAG='{{ draftbot_image_tag }}'

# The edge: HTTPS for this name, with a certificate Caddy gets and renews itself.
EDGE_SITE='{{ draftbot_domain }}'
{% if draftbot_tls_internal | bool %}
EDGE_TLS='tls internal'
{% endif %}
{% if draftbot_admin_cidrs %}
EDGE_ADMIN_CIDRS='{{ draftbot_admin_cidrs | join(" ") }}'
{% endif %}

# Discord
DISCORD_TOKEN='{{ draftbot_discord_token }}'
DISCORD_GUILD_ID='{{ draftbot_discord_guild_id }}'
ERROR_LOG_CHANNEL_ID='{{ draftbot_error_log_channel_id }}'
HEALTHCHECK_PING_URL='{{ draftbot_healthcheck_ping_url }}'

# Django, behind the edge's TLS. compose.prod.yaml forces DEBUG off as well.
DJANGO_SECRET_KEY='{{ draftbot_django_secret_key }}'
DEBUG='false'
ALLOWED_HOSTS='{{ draftbot_domain }}'
CSRF_TRUSTED_ORIGINS='https://{{ draftbot_domain }}'
BEHIND_TLS_PROXY='true'
SECURE_COOKIES='true'
LOG_LEVEL='{{ draftbot_log_level }}'

# Postgres. compose builds the app's DATABASE_URL from it.
POSTGRES_PASSWORD='{{ draftbot_postgres_password }}'

# Optional services
DEADLOCK_API_KEY='{{ draftbot_deadlock_api_key }}'
STEAM_WEB_API_KEY='{{ draftbot_steam_web_api_key }}'
{% for key, value in draftbot_env_extra | dictsort %}
{{ key }}='{{ value }}'
{% endfor %}
