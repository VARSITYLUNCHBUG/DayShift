# Copy to .env and fill in. Never commit .env.
#
# This is the app's environment: compose hands all of it to migrate, web, bot and scheduler, and
# also reads it for the compose variables further down. Secrets the app has no use for go
# elsewhere: the observability overlay's in .env.observability (.env.observability.example).

# Discord
DISCORD_TOKEN=
DISCORD_GUILD_ID=

# Django
DJANGO_SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://admin.example.com
# Set both if the admin sits behind a TLS reverse proxy. Without TLS, set SECURE_COOKIES=false.
# BEHIND_TLS_PROXY=true
SECURE_COOKIES=false

# Database. Two roles: POSTGRES_PASSWORD is the superuser's (draftbot), for migrate and you;
# DB_APP_PASSWORD is draftbot_app's, which web, bot and scheduler log in as through pgbouncer and
# which can only read and write the app's tables. migrate creates it and keeps its password up to
# date; the app's containers get POSTGRES_PASSWORD blanked. Without DB_APP_PASSWORD the app's
# role gets POSTGRES_PASSWORD's value, so set both, to different values. DATABASE_URL here is for
# running manage.py on this machine against the compose database (published on
# 127.0.0.1:DB_PORT). The passwords go into URLs, so use letters and digits only (openssl rand
# -hex 32).
POSTGRES_PASSWORD=change-me
DB_APP_PASSWORD=change-me-too
DATABASE_URL=postgres://draftbot:change-me@127.0.0.1:55432/draftbot

# Compose variables, with their defaults. Where the edge listens on this machine
# (http://127.0.0.1:8000), where Postgres is published for host tools, and the image
# `docker compose pull` fetches (`--build` builds it here instead, INSTALL_OCR=true with score OCR).
# EDGE_PORT=8000
# DB_PORT=55432
# Postgres' CPU limit. Docker refuses one above the machine's CPU count: set 1 on a 1-CPU server.
# DB_CPUS=2
# DRAFTBOT_IMAGE=ghcr.io/varsitylunchbug/dl-mm-discord
# DRAFTBOT_IMAGE_TAG=latest
# INSTALL_OCR=false
# The edge network: its subnet, the edge's fixed address in it (the only one web believes proxy
# headers from) and the range Docker assigns every other address from, outside that address.
# Change them together, only if the subnet collides with a network on this host.
# EDGE_SUBNET=10.203.140.0/28
# EDGE_IP=10.203.140.2
# EDGE_IP_RANGE=10.203.140.8/29
# Its IPv6 subnet (a private /64), so IPv6 clients reach the edge with their own address.
# EDGE_SUBNET6=fd0d:7261:6674:140::/64
# Optional admin access control at the edge: a folder of nginx *.conf files (IP allowlist, basic
# auth) included in the /admin/ locations. See infra/nginx/admin-access/README.md.
# EDGE_ADMIN_ACCESS_DIR=./infra/nginx/admin-access
# Postgres memory, for its 1 GB container limit.
# POSTGRES_SHARED_BUFFERS=256MB
# POSTGRES_EFFECTIVE_CACHE_SIZE=768MB

# Observability (compose.observability.yaml). The exporters' read-only database role
# (draftbot_monitor), created by migrate: letters and digits only (openssl rand -hex 32). Required
# with the overlay; the app's containers get it blanked. Grafana's password and the alert webhook
# go in .env.observability.
# DB_MONITOR_PASSWORD=
# The edge's public name, for the certificate probe (production sets it anyway).
# EDGE_SERVER_NAME=
# GRAFANA_PORT=13000
# PROMETHEUS_PORT=19090
# PROMETHEUS_RETENTION=15d
# PROMETHEUS_RETENTION_SIZE=5GB
# OBSERVABILITY_ENV_FILE=.env.observability
# deploy/compose.prod.yaml and deploy/compose.grafana.yaml also read EDGE_SITE_TEMPLATES,
# GRAFANA_DOMAIN and EDGE_GRAFANA_CONF; the deploy's Ansible roles set those.

LOG_LEVEL=INFO
# json (the default) or text, which reads better in a terminal.
# LOG_FORMAT=json
# Optional. A channel ID where the bot posts every error with its full traceback, for whoever
# runs the bot. Each server can also pick its own channel for its own errors: /seterrorchannel.
ERROR_LOG_CHANNEL_ID=

# deadlock-api.com. Optional key: raises its limits, such as bot-hosted lobbies from 10 an hour
# per IP to 100 per 30 minutes. The lobby region and result checks are settings in the admin.
DEADLOCK_API_KEY=
# Optional. Only needed for /link with a custom profile URL (steamcommunity.com/id/name).
STEAM_WEB_API_KEY=

# Player web UI. PUBLIC_URL is where players reach it; sign-in redirects are built from it.
# The client ID and secret are on the Discord application's OAuth2 page, and the redirect there is
# PUBLIC_URL/auth/discord/callback/ (with the trailing slash). WEB_GUILD_ID defaults to
# DISCORD_GUILD_ID.
PUBLIC_URL=http://localhost:8000
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# WEB_GUILD_ID=
# Only without pgbouncer (DB_POOL=true, a bare uvicorn): sizes psycopg's pool in the web process
# (WEB_DB_THREADS + 2). compose always runs pgbouncer, where it changes nothing.
# WEB_DB_THREADS=8
# Local testing only, with DEBUG=true: sign in as any player without Discord.
# WEB_DEV_LOGIN=true

# The bot's and the scheduler's Prometheus metrics (0 turns them off). Loopback by default, for
# a run on this machine; compose sets METRICS_ADDR=0.0.0.0 inside the container network.
# METRICS_PORT=9108
# METRICS_ADDR=127.0.0.1
