# Local dev stack against the Discord simulator. scripts/fixture_to_test copies this to .env.dev
# when it's missing. Nothing here is secret: the token is fake and only the simulator accepts it.
# compose.dev.yaml also sets DEBUG, DEV_CONTROL, WEB_DEV_LOGIN and the database for every service.

# Django
DJANGO_SECRET_KEY=dev-only-not-secret
SECURE_COOKIES=false
PUBLIC_URL=http://localhost:18080
LOG_LEVEL=INFO

# Discord, pointed at the simulator (the discord-sim service). Its seeded guild has this id.
DISCORD_TOKEN=sim-token
DISCORD_GUILD_ID=1100000000000000001
DISCORD_API_BASE=http://discord-sim:8090/api/v10
DISCORD_GATEWAY_URL=ws://discord-sim:8090/gateway
DISCORD_SIM_URL=http://discord-sim:8090

# Everything below is a compose variable, read from the shell (or a .env beside compose.yaml),
# not from this file. Defaults:
#
# Dev stack (compose.dev.yaml). Host ports, all on 127.0.0.1:
#   DEV_EDGE_PORT=18080  DEV_WEB_PORT=18000  DEV_SIM_PORT=18090  DEV_PANEL_PORT=18091
#   DEV_DB_PORT=15432
# The edge network, the edge's fixed address in it, and the range for every other address:
#   DEV_EDGE_SUBNET=10.203.140.16/28  DEV_EDGE_IP=10.203.140.18  DEV_EDGE_IP_RANGE=10.203.140.24/29
# The dev database's password (used when its volume is created: change it with --fresh), and the
# app's role's (draftbot_app, which the bot and the scheduler log in as; migrate sets it):
#   DEV_DB_PASSWORD=dev  DEV_DB_APP_PASSWORD=dev-app
# The app's env file (this one; scripts/fixture_to_test --real-discord uses .env), the log format
# (text, or json), and fake members the simulator seeds:
#   DRAFTBOT_ENV_FILE=.env.dev  LOG_FORMAT=text  SIM_SEED_USERS=0
# With the observability overlay as well: GRAFANA_PORT=13000 PROMETHEUS_PORT=19090, a
# DB_MONITOR_PASSWORD of your choice, and GRAFANA_ADMIN_PASSWORD in .env.observability.
#
# Test stack (compose.test.yaml, scripts/test.sh): no host ports. The edge network, and the uid
# and gid the e2e suite writes test-results/ as (scripts/test.sh sets them on Linux):
#   TEST_EDGE_SUBNET=10.203.140.32/28  TEST_EDGE_IP=10.203.140.34  TEST_EDGE_IP_RANGE=10.203.140.40/29
#   DRAFTBOT_UID=1001  DRAFTBOT_GID=1001
