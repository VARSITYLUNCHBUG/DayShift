# {{ ansible_managed }}
[Unit]
Description=dl-mm-discord compose project in {{ app_root }}
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=draftbot-notify@%n.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ app_root }}
# Every service healthy, or the unit fails and says so.
ExecStart=/usr/bin/docker compose up --detach --wait --wait-timeout 600 --remove-orphans
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=900
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
