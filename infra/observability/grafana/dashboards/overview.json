        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(draftbot_http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99"
